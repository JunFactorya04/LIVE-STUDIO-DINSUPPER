{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LIVE STUDIO",
        "width": 1240,
        "height": 800,
        "minWidth": 390,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  }
}
